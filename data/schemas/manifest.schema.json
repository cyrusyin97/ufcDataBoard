{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "datasetVersion": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}-[a-f0-9]{16}$"
    },
    "asOf": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    },
    "sourceDatabaseSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "boutAnalysis": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "const": 1
        },
        "formulaVersion": {
          "type": "string",
          "const": "1.1"
        },
        "policyVersion": {
          "type": "string",
          "minLength": 1
        },
        "boutCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "referenceCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "schemaVersion",
        "formulaVersion",
        "policyVersion",
        "boutCount",
        "referenceCount"
      ],
      "additionalProperties": false
    },
    "sourceCounts": {
      "type": "object",
      "properties": {
        "fighters": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "events": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "fights": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "fight_details": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        }
      },
      "required": ["fighters", "events", "fights", "fight_details"],
      "additionalProperties": false
    },
    "counts": {
      "type": "object",
      "properties": {
        "fighters": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "records": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "bouts": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "divisions": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "mediaAssets": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "fieldConflicts": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "fighters",
        "records",
        "bouts",
        "divisions",
        "mediaAssets",
        "fieldConflicts"
      ],
      "additionalProperties": false
    },
    "files": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": ["sha256", "bytes"],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "datasetVersion",
    "asOf",
    "sourceDatabaseSha256",
    "sourceCounts",
    "counts",
    "files"
  ],
  "additionalProperties": false
}
