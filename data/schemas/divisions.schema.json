{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "datasetVersion": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}-[a-f0-9]{16}$"
    },
    "defaultDivisionId": {
      "type": "string"
    },
    "divisions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "weightLb": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "publicationState": {
            "type": "string",
            "enum": ["published", "draft"]
          },
          "snapshotAt": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          },
          "sourceUrl": {
            "type": "string",
            "format": "uri"
          },
          "defaultFighterId": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{16}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "entries": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "fighterId": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{16}$"
                },
                "rank": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "isChampion": {
                  "type": "boolean"
                }
              },
              "required": ["fighterId", "rank", "isChampion"],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "label",
          "weightLb",
          "publicationState",
          "snapshotAt",
          "sourceUrl",
          "defaultFighterId",
          "entries"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "datasetVersion",
    "defaultDivisionId",
    "divisions"
  ],
  "additionalProperties": false
}
