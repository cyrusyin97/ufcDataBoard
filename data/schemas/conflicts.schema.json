{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "datasetVersion": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}-[a-f0-9]{16}$"
    },
    "observations": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "fighterId": {
                "type": "string",
                "pattern": "^[a-f0-9]{16}$"
              },
              "field": {
                "type": "string",
                "const": "careerRecord"
              },
              "ufcstats": {
                "type": "object",
                "properties": {
                  "wins": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "losses": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "draws": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "noContests": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": ["wins", "losses", "draws", "noContests"],
                "additionalProperties": false
              },
              "ufcCom": {
                "type": "object",
                "properties": {
                  "wins": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "losses": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "draws": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": ["wins", "losses", "draws"],
                "additionalProperties": false
              }
            },
            "required": ["fighterId", "field", "ufcstats", "ufcCom"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "fighterId": {
                "type": "string",
                "pattern": "^[a-f0-9]{16}$"
              },
              "field": {
                "type": "string",
                "enum": ["height", "reach"]
              },
              "ufcstatsInches": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "ufcComInches": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "required": [
              "fighterId",
              "field",
              "ufcstatsInches",
              "ufcComInches"
            ],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "required": ["schemaVersion", "datasetVersion", "observations"],
  "additionalProperties": false
}
