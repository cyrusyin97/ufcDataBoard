{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "datasetVersion": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}-[a-f0-9]{16}$"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-f0-9]{16}$"
    },
    "fighterIds": {
      "type": "array",
      "prefixItems": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{16}$"
        },
        {
          "type": "string",
          "pattern": "^[a-f0-9]{16}$"
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "divisionId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "boutType": {
      "type": ["string", "null"]
    },
    "eventName": {
      "type": ["string", "null"]
    },
    "eventDate": {
      "anyOf": [
        {
          "type": "string",
          "format": "date",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "sourceUrl": {
      "anyOf": [
        {
          "type": "string",
          "format": "uri"
        },
        {
          "type": "null"
        }
      ]
    },
    "capturedAt": {
      "type": ["string", "null"]
    },
    "timeFormat": {
      "type": ["string", "null"]
    },
    "endRound": {
      "anyOf": [
        {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "endTime": {
      "type": ["string", "null"]
    },
    "method": {
      "type": ["string", "null"]
    },
    "outcomes": {
      "type": "array",
      "prefixItems": [
        {
          "anyOf": [
            {
              "type": "string",
              "enum": ["W", "L", "D", "NC"]
            },
            {
              "type": "null"
            }
          ]
        },
        {
          "anyOf": [
            {
              "type": "string",
              "enum": ["W", "L", "D", "NC"]
            },
            {
              "type": "null"
            }
          ]
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "periods": {
      "type": "array",
      "items": {
        "type": "object",
