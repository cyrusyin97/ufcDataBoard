                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": ["fighterId", "stats"],
                "additionalProperties": false
              }
            ],
            "items": false,
            "minItems": 2,
            "maxItems": 2
          }
        },
        "required": ["round", "elapsedSeconds", "participants"],
        "additionalProperties": false
      }
