    "issues": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "missing-stats",
          "missing-period",
          "unknown-duration",
          "unmapped-division",
          "event-conflict",
          "invalid-stats",
          "incomplete-stats"
        ]
      }
    },
    "referenceId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
