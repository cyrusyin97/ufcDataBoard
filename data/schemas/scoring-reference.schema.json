{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "datasetVersion": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}-[a-f0-9]{16}$"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "formulaVersion": {
      "type": "string",
      "const": "1.1"
    },
    "policyVersion": {
      "type": "string",
      "minLength": 1
    },
    "sourceDatabaseSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "divisionId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "windowStart": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    },
    "cutoffExclusive": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    },
    "distinctBoutCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "minimumBoutCount": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "status": {
      "type": "string",
      "enum": ["available", "insufficient-cohort"]
    },
    "periods": {
      "type": "object",
      "properties": {
        "bout": {
          "type": "object",
          "properties": {
            "observationCount": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "bounds": {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "enum": [
                  "distance_landed",
                  "distance_attempted",
                  "clinch_landed",
                  "clinch_attempted",
                  "td_landed",
                  "td_attempted",
                  "sub_att",
                  "ctrl_seconds",
                  "ground_landed",
                  "sig_landed",
                  "kd"
                ]
              },
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "upper": {
                    "anyOf": [
                      {
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "method": {
                    "anyOf": [
                      {
                        "type": "string",
                        "enum": ["P95", "P99", "MAX"]
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": ["upper", "method"],
                "additionalProperties": false
              },
              "required": [
                "distance_landed",
                "distance_attempted",
                "clinch_landed",
                "clinch_attempted",
                "td_landed",
                "td_attempted",
                "sub_att",
                "ctrl_seconds",
                "ground_landed",
                "sig_landed",
                "kd"
              ]
            }
          },
          "required": ["observationCount", "bounds"],
          "additionalProperties": false
        },
        "round": {
          "type": "object",
          "properties": {
            "observationCount": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "bounds": {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "enum": [
                  "distance_landed",
                  "distance_attempted",
                  "clinch_landed",
                  "clinch_attempted",
                  "td_landed",
                  "td_attempted",
                  "sub_att",
                  "ctrl_seconds",
                  "ground_landed",
                  "sig_landed",
                  "kd"
                ]
              },
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "upper": {
                    "anyOf": [
                      {
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "method": {
                    "anyOf": [
                      {
                        "type": "string",
                        "enum": ["P95", "P99", "MAX"]
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": ["upper", "method"],
                "additionalProperties": false
              },
              "required": [
                "distance_landed",
                "distance_attempted",
                "clinch_landed",
                "clinch_attempted",
                "td_landed",
                "td_attempted",
                "sub_att",
                "ctrl_seconds",
                "ground_landed",
                "sig_landed",
                "kd"
              ]
            }
          },
          "required": ["observationCount", "bounds"],
          "additionalProperties": false
        }
      },
      "required": ["bout", "round"],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "datasetVersion",
    "id",
    "formulaVersion",
    "policyVersion",
    "sourceDatabaseSha256",
    "divisionId",
    "windowStart",
    "cutoffExclusive",
    "distinctBoutCount",
    "minimumBoutCount",
    "status",
    "periods"
  ],
  "additionalProperties": false
}
