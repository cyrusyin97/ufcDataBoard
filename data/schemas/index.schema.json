{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "datasetVersion": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}-[a-f0-9]{16}$"
    },
    "fighters": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-f0-9]{16}$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "displayName": {
            "type": "string",
            "minLength": 1
          },
          "ufcSlug": {
            "type": ["string", "null"]
          }
        },
        "required": ["id", "name", "displayName", "ufcSlug"],
        "additionalProperties": false
      }
    }
  },
  "required": ["schemaVersion", "datasetVersion", "fighters"],
  "additionalProperties": false
}
