# The initial app needs no credentials.
# Export jobs read UFC_DB_PATH outside the web runtime.
# UFC_DB_PATH=/absolute/path/to/ufc.db

# Build-only HTTPS URL for the SHA-256-pinned release archive.
# Configure it in GitHub Actions secrets and Vercel build environment variables.
# UFC_DATASET_URL=https://approved-artifact-host/path/to/release.tar.gz
